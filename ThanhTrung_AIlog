    </style>
</head>
<body>

    <h2>🏥 Smart Hospital - Quy trình cấu trúc dữ liệu</h2>
    
    <div style="background: white; padding: 15px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
        <h3>1. Quầy tiếp nhận (Hash Table & Đẩy vào Queue)</h3>
        <input type="text" id="name" placeholder="Nhập tên bệnh nhân...">
        <select id="priority">
            <option value="1">Ưu tiên 1 - Nguy kịch</option>
            <option value="2">Ưu tiên 2 - Khám thường</option>
            <option value="3">Ưu tiên 3 - Tái khám</option>
        </select>
        <button onclick="addPatient()">➕ Đăng ký bệnh nhân</button>
        <button onclick="treatPatient()" style="background: #28a745;">🩺 Gọi vào khám (Dequeue)</button>
    </div>

    <div class="container">
        <div class="box">
            <h3>2. Hàng Chờ Khám (Priority Queue - Heap)</h3>
            <p style="font-size: 13px; color: gray;">*Người mức 1 luôn bị đẩy lên đầu</p>
            <div id="queue-list"></div>
        </div>

        <div class="box">
            <h3>3. Lịch Sử Bệnh Án (Doubly Linked List)</h3>
            <p style="font-size: 13px; color: gray;">*Lưu các ca đã khám xong</p>
            <div id="history-list"></div>
        </div>
    </div>

    <script>
        let pq = []; // Mô phỏng Priority Queue
        let historyList = []; // Mô phỏng Doubly Linked List
        let idCounter = 101;

        // Hành động 1: Đăng ký (Đẩy vào Heap)
        function addPatient() {
            let name = document.getElementById("name").value;
            let prio = parseInt(document.getElementById("priority").value);
            if(!name) { alert("Nhập tên vô m!"); return; }
            
            // Tạo bệnh nhân
            let p = { id: idCounter++, name: name, prio: prio };
            pq.push(p);
            
            // Mô phỏng thuật toán Heapify (Sắp xếp lại để ưu tiên nhỏ nhất lên đầu)
            pq.sort((a, b) => a.prio - b.prio); 
            
            document.getElementById("name").value = "";
            render();
        }

        // Hành động 2: Khám bệnh (Rút khỏi Heap, đẩy vào DLL)
        function treatPatient() {
            if(pq.length === 0) { alert("Hàng chờ trống!"); return; }
            
            // Rút người đầu tiên ra (Pop from Heap)
            let treated = pq.shift(); 
            
            // Đẩy vào Lịch sử (Add to DLL)
            historyList.push(treated); 
            render();
        }

        // Cập nhật giao diện
        function render() {
            // Render hàng chờ
            document.getElementById("queue-list").innerHTML = pq.map(p => 
                `<div class='patient p${p.prio}'>🆔 BN${p.id} | ${p.name} <br> <small>Mức ưu tiên: ${p.prio}</small></div>`
            ).join('');

            // Render lịch sử
            document.getElementById("history-list").innerHTML = historyList.map((p, index) => {
                let prev = index > 0 ? historyList[index-1].id : "NULL";
                let next = index < historyList.length - 1 ? historyList[index+1].id : "NULL";
                return `<div class='patient' style='border-color: #6c757d; background: #e9ecef;'>
                    ✅ BN${p.id} | ${p.name} <br>
                    <small style='color:blue'>[Con trỏ DLL] Prev: BN${prev} | Next: BN${next}</small>
                </div>`;
            }).join('');
        }
    </script>

</body>
</html>
