<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Lịch Sử Bệnh Án (DLL)</title>
    <style>
        body { font-family: Arial; padding: 50px; background: #f4f4f9; }
        .card { background: white; padding: 20px; border-radius: 10px; width: 400px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); }
        h2 { color: #2c3e50; }
        .info { font-size: 18px; margin-bottom: 10px; }
        .btn { padding: 10px 20px; margin: 5px; cursor: pointer; background: #3498db; color: white; border: none; border-radius: 5px; }
        .btn:hover { background: #2980b9; }
        .btn:disabled { background: #bdc3c7; cursor: not-allowed; }
    </style>
</head>
<body>

    <div class="card">
        <h2>Hồ Sơ Bệnh Án: <span id="tenBN">Nguyễn Văn A</span></h2>
        <div class="info"><strong>Ngày khám:</strong> <span id="ngayKham"></span></div>
        <div class="info"><strong>Chẩn đoán:</strong> <span id="chanDoan"></span></div>
        
        <div style="margin-top: 20px;">
            <button class="btn" id="btnPrev" onclick="xemCaTruoc()">⬅ Quá khứ</button>
            <button class="btn" id="btnNext" onclick="xemCaSau()">Hiện tại ➡</button>
        </div>
    </div>

    <script>
        // ==========================================
        // LÕI CẤU TRÚC DỮ LIỆU DLL (CHẠY NGẦM DƯỚI JS)
        // ==========================================
        class Node {
            constructor(ngay, benh) {
                this.ngay = ngay;
                this.benh = benh;
                this.prev = null;
                this.next = null;
            }
        }

        class DLL {
            constructor() {
                this.head = null;
                this.tail = null;
                this.current = null; // Con trỏ đang xem
            }

            addLast(ngay, benh) {
                let newNode = new Node(ngay, benh);
                if (!this.head) {
                    this.head = this.tail = this.current = newNode;
                    return;
                }
                newNode.prev = this.tail;
                this.tail.next = newNode;
                this.tail = newNode;
                this.current = this.tail; // Luôn trỏ về ca mới nhất
            }
        }

        // ==========================================
        // KHỞI TẠO DỮ LIỆU (MOCK DATA)
        // ==========================================
        let lichSuBN101 = new DLL();
        lichSuBN101.addLast("10/01/2025", "Sốt siêu vi");
        lichSuBN101.addLast("05/08/2025", "Đau dạ dày");
        lichSuBN101.addLast("17/05/2026", "Viêm họng hạt"); // Ca mới nhất

        // ==========================================
        // GIAO TIẾP VỚI MÀN HÌNH WEB
        // ==========================================
        
        // Hàm in dữ liệu từ biến 'current' ra HTML
        function renderUI() {
            if (!lichSuBN101.current) return;
            document.getElementById('ngayKham').innerText = lichSuBN101.current.ngay;
            document.getElementById('chanDoan').innerText = lichSuBN101.current.benh;
            
            // Khóa nút nếu hết đường lui/tiến
            document.getElementById('btnPrev').disabled = (lichSuBN101.current.prev === null);
            document.getElementById('btnNext').disabled = (lichSuBN101.current.next === null);
        }

        // Bắt sự kiện lùi
        function xemCaTruoc() {
            if (lichSuBN101.current.prev) {
                lichSuBN101.current = lichSuBN101.current.prev; // O(1)
                renderUI();
            }
        }

        // Bắt sự kiện tiến
        function xemCaSau() {
            if (lichSuBN101.current.next) {
                lichSuBN101.current = lichSuBN101.current.next; // O(1)
                renderUI();
            }
        }

        // Chạy lần đầu khi vừa mở Web
        renderUI();
    </script>
</body>
</html>
