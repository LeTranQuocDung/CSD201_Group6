2. Code triển khai (Java)
Tôi sẽ viết code theo chuẩn để bạn dễ giải trình. Lưu ý: Tôi đã tích hợp sẵn logic "Cùng ưu tiên thì ai đến trước khám trước" - đây là điểm cộng lớn.

Java
import java.util.*;

class Patient {
    int id;
    String name;
    int priority; // 1 (High) to 5 (Low)
    long timestamp; // Thời gian đến

    public Patient(int id, String name, int priority) {
        this.id = id;
        this.name = name;
        this.priority = priority;
        this.timestamp = System.nanoTime(); // Dùng nanoTime để tránh trùng lặp
    }

    @Override
    public String toString() {
        return String.format("[ID: %d | Tên: %s | Độ ưu tiên: %d]", id, name, priority);
    }
}

// 1. Priority Queue dùng Min-Heap
class TriageQueue {
    private List<Patient> heap;

    public TriageQueue() {
        heap = new ArrayList<>();
    }

    public void enqueue(Patient p) {
        heap.add(p);
        int current = heap.size() - 1;
        while (current > 0) {
            int parent = (current - 1) / 2;
            if (compare(heap.get(current), heap.get(parent)) < 0) {
                swap(current, parent);
                current = parent;
            } else break;
        }
    }

    public Patient dequeue() {
        if (heap.isEmpty()) return null;
        Patient top = heap.get(0);
        Patient last = heap.remove(heap.size() - 1);
        if (!heap.isEmpty()) {
            heap.set(0, last);
            heapify(0);
        }
        return top;
    }

    private void heapify(int index) {
        int smallest = index;
        int left = 2 * index + 1;
        int right = 2 * index + 2;

        if (left < heap.size() && compare(heap.get(left), heap.get(smallest)) < 0) smallest = left;
        if (right < heap.size() && compare(heap.get(right), heap.get(smallest)) < 0) smallest = right;

        if (smallest != index) {
            swap(index, smallest);
            heapify(smallest);
        }
    }

    // Logic quan trọng: So sánh ưu tiên, nếu bằng nhau thì so sánh thời gian
    private int compare(Patient p1, Patient p2) {
        if (p1.priority != p2.priority) return p1.priority - p2.priority;
        return Long.compare(p1.timestamp, p2.timestamp);
    }

    private void swap(int i, int j) {
        Patient temp = heap.get(i);
        heap.set(i, heap.get(j));
        heap.set(j, temp);
    }
    
    public boolean isEmpty() { return heap.isEmpty(); }
}

// 2. Doubly Linked List cho Lịch sử
class HistoryNode {
    Patient data;
    HistoryNode next, prev;
    public HistoryNode(Patient p) { this.data = p; }
}

class MedicalHistory {
    private HistoryNode head, tail;

    public void addRecord(Patient p) {
        HistoryNode newNode = new HistoryNode(p);
        if (head == null) head = tail = newNode;
        else {
            tail.next = newNode;
            newNode.prev = tail;
            tail = newNode;
        }
    }

    public void showHistory() {
        HistoryNode temp = head;
        System.out.println("--- LỊCH SỬ KHÁM BỆNH ---");
        while (temp != null) {
            System.out.println(temp.data);
            temp = temp.next;
        }
    }
}

// 3. Main
public class SmartHospital {
    public static void main(String[] args) {
        TriageQueue queue = new TriageQueue();
        MedicalHistory history = new MedicalHistory();

        // Thêm bệnh nhân
        queue.enqueue(new Patient(101, "Nguyen Van A", 3));
        queue.enqueue(new Patient(102, "Tran Thi B", 1)); // Cấp cứu
        queue.enqueue(new Patient(103, "Le Van C", 3)); // Trùng mức ưu tiên với A

        // Khám bệnh
        while (!queue.isEmpty()) {
            Patient p = queue.dequeue();
            System.out.println("Đang khám: " + p);
            history.addRecord(p);
        }

        history.showHistory();
    }
}
