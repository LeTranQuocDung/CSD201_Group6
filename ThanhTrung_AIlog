<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Mô phỏng Smart Hospital</title>
    <style>
        body { font-family: Arial; padding: 20px; background: #f4f7f6; }
        .container { display: flex; gap: 20px; margin-top: 20px; }
        .box { background: white; border-radius: 8px; padding: 15px; width: 350px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); }
        .patient { padding: 10px; margin: 8px 0; border-radius: 5px; font-weight: bold; border-left: 6px solid #ccc; transition: all 0.3s;}
        .p1 { background: #ffebee; border-color: #f44336; } /* Cấp cứu - Đỏ */
        .p2 { background: #fff8e1; border-color: #ffc107; } /* Vừa - Cam */
