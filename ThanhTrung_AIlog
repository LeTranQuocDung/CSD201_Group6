Đây là lớp chứa thuật toán (Add, Lùi, Tiến) để móc các MedicalRecordNode lại với nhau thành một Danh sách liên kết đôi hoàn chỉnh.

Java
public class HistoryDLL {
    MedicalRecordNode head;    // Ca khám đầu tiên trong đời
    MedicalRecordNode tail;    // Ca khám mới nhất
    MedicalRecordNode current; // "Con trỏ mắt nhìn" đang xem ca nào

    public HistoryDLL() {
        this.head = null;
        this.tail = null;
        this.current = null;
    }

    // Thuật toán Thêm hồ sơ mới (Tốc độ O(1))
    public void addLast(String recordId, String date, String diagnosis, String doctorId) {
        MedicalRecordNode newNode = new MedicalRecordNode(recordId, date, diagnosis, doctorId);
        
        if (head == null) {
            // Nếu danh sách trống, người mới vào làm trùm tất cả
            head = tail = current = newNode;
            return;
        }
        
        // Nối dây
        newNode.prev = tail;
        tail.next = newNode;
        tail = newNode;
        
        // Khám xong thì tự động lật màn hình về ca mới nhất
        current = tail; 
    }

    // Thuật toán Xem ca trước (Lùi về quá khứ - Tốc độ O(1))
    public void goPrev() {
        if (current != null && current.prev != null) {
            current = current.prev; // Dịch con trỏ lùi lại 1 bước
            System.out.println("⬅ Đã lùi về ca trước:");
            current.printRecord();
        } else {
            System.out.println("❌ CẢNH BÁO: Đây là ca khám đầu tiên, không có dữ liệu cũ hơn!");
        }
    }

    // Thuật toán Xem ca sau (Tiến tới tương lai - Tốc độ O(1))
    public void goNext() {
        if (current != null && current.next != null) {
            current = current.next; // Dịch con trỏ tiến lên 1 bước
            System.out.println("➡ Đã tiến tới ca sau:");
            current.printRecord();
        } else {
            System.out.println("❌ CẢNH BÁO: Đây là ca khám mới nhất!");
        }
    }
    
    // In ca đang xem hiện tại
    public void printCurrent() {
        if (current != null) {
            System.out.println("📍 Ca đang xem hiện tại:");
            current.printRecord();
        }
    }
}
